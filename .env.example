# Copy to credentials/asc-api-key.p8 (gitignored) — never commit the real file.
# Get Key ID + Issuer ID from App Store Connect → Users and Access → Integrations → API

EXPO_APPLE_APP_STORE_CONNECT_KEY_PATH=./credentials/asc-api-key.p8
EXPO_APPLE_APP_STORE_CONNECT_KEY_ID=
EXPO_APPLE_APP_STORE_CONNECT_ISSUER_ID=

# Optional: if `eas login` does not work
# EXPO_TOKEN=
